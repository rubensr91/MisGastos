# Copia este fichero como "keystore.properties" y rellena los cuatro datos.
# "keystore.properties" esta en .gitignore: NUNCA subas las contrasenas a git.
#
# Generar un almacen de claves de subida:
#   keytool -genkeypair -v \
#     -keystore keystore/misgastos-upload.jks \
#     -storetype PKCS12 \
#     -alias misgastos-upload \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=keystore/misgastos-upload.jks
storePassword=CAMBIA_ESTA_CONTRASENA
keyAlias=misgastos-upload
keyPassword=CAMBIA_ESTA_CONTRASENA
