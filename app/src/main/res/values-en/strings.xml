    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Your expenses, on autopilot</string>
    <string name="onboarding_welcome_body">Every time you pay with your card, your bank sends a notification. My Expenses reads it, stores the amount and that is it: nothing to open, nothing to tap.</string>
