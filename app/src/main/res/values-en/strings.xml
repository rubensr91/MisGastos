    <string name="onboarding_welcome_point_2">Amount, merchant and date stored on your own phone</string>
    <string name="onboarding_welcome_point_3">Charts and stats by day, month, merchant or category</string>
    <string name="onboarding_welcome_point_4">No account, no cloud, no internet access</string>

    <string name="onboarding_access_title">Notification access is required</string>
    <string name="onboarding_access_body">This is the permission Android demands before an app can read what other apps post. Enable it in system settings and come back; this screen refreshes on its own.</string>
